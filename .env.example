# The Compose stack wires queries to the Q-PRIME core automatically.
CONTINUUM_DB="qprime"
CONTINUUM_TABLE="continuum"
NEXT_PUBLIC_SQL_TABLE_NAME="qprime.continuum"
EPOCH_SCALE="s"
LOCAL_TZ_NAME="Australia/Sydney"

# Optional AWS Cloud placement and Athena query target.
AWS_CLOUD_ENABLED=false
AWS_REGION=""
AWS_INGEST_MODE="firehose"
AWS_KINESIS_STREAM=""
AWS_FIREHOSE_STREAM=""
AWS_ATHENA_DATABASE=""
AWS_ATHENA_TABLE=""
AWS_ATHENA_WORKGROUP="primary"
AWS_ATHENA_OUTPUT=""
# Use the normal AWS provider chain; never commit real credentials.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""

# Optional web mount path. Empty serves the application at http://localhost:3000/.
NEXT_PUBLIC_BASE_PATH=""

# Optional local language model. Rule-based SQL and summaries are the default.
USE_LLM_SQL=1
USE_LLM_SUMMARY=1
OLLAMA_HOST="http://ollama:11434"
MODEL="qwen2.5:7b-instruct-q4_K_M"
