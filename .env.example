# External read-only query endpoint. Leave empty until a data source is connected.
# In Docker, a service running on the host is commonly reached through
# http://host.docker.internal:<port>/<path>.
QUERY_API_URL="http://your-query-service/api/quer"

# Logical table and timestamp representation exposed by that endpoint.
CONTINUUM_DB="qprime"
CONTINUUM_TABLE="continuum"
NEXT_PUBLIC_SQL_TABLE_NAME="qprime.continuum"
EPOCH_SCALE="s"
LOCAL_TZ_NAME="Australia/Sydney"

# Optional web mount path. Empty serves the application at http://localhost:3000/.
NEXT_PUBLIC_BASE_PATH=""

# Optional local language model. Rule-based SQL and summaries are the default.
USE_LLM_SQL=1
USE_LLM_SUMMARY=1
OLLAMA_HOST=http://ollama:11434
MODEL=qwen2.5:7b-instruct-q4_K_M
